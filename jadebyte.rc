// Windows resources for JadeByte.
//
// Compiled into the executable so Explorer, the taskbar and the title bar show
// the game's own icon instead of a generic program icon, and so the file's
// Properties dialog shows a product name, description and copyright.
//
//   windres jadebyte.rc -O coff -o jadebyte_resource.o
//   g++ main.cpp jadebyte_resource.o -o JadeByte.exe -lraylib -lopengl32 -lgdi32 -lwinmm

#include <windows.h>

// Icon shown by Explorer and the taskbar. 1 is the lowest icon ID, which is the
// one Windows picks for the shortcut/executable. GLFW_ICON is the name GLFW
// (raylib's window backend) looks up for the window title bar, so the game
// window gets the same icon.
1 ICON "jadebyte.ico"
GLFW_ICON ICON "jadebyte.ico"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,0,0,0
    PRODUCTVERSION  1,0,0,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
    FILEFLAGS       0x0L
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "JadeByte"
            VALUE "FileDescription",  "JadeByte - Programming Quiz"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "JadeByte"
            VALUE "LegalCopyright",   "Copyright (C) 2026 JadeByte"
            VALUE "OriginalFilename", "JadeByte.exe"
            VALUE "ProductName",      "JadeByte"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
